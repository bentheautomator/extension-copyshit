{
  "manifest_version": 3,
  "name": "Link and Text Copy Tracker",
  "version": "1.1",
  "description": "Captures copied text and links into a CSV format",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
